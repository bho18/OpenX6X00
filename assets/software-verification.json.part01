e}},"model_shim":{"path":"/workspace/build/x6200-freedv-live-gain-20261107.3-r4/ci-recovery/wget-shim","sha256":"eeffd9089007977ee1080587d2bfa92af8a9be89199b898644be121bdeac0ed0"},"artifact_transport":{"path":"/workspace/build/x6200-freedv-live-gain-20261107.3-r4/ci-recovery/plugin-receipt-downloads.json","sha256":"0bc17296276bd77cbf7149a16ca8e537555d8c2a3eea89351f37db084b82c5b5","receipt":{"schema":"x6200.ci.artifact-transport.v1","run_id":42421612997,"github_zip_digests_verified":true,"artifacts":[{"artifact_id":13594242970,"artifact_name":"tested-source-usb-controller-regression","github_archive_size":88818,"github_archive_sha256":"9311da340bef486cf02bf808b932d09726e59a9bb5a2e919086913d4b37f61ec","zip_path":"/workspace/build/x6200-freedv-live-gain-20261107.3-r4/ci-recovery/actual-ci-receipts/tested-source-usb-controller-regression.zip","receipt_path":"/workspace/build/x6200-freedv-live-gain-20261107.3-r4/ci-recovery/actual-ci-receipts/tested-source-usb-controller-regression.json","receipt_sha256":"2e81ed68e6a278e4d4de437db37c228c5d139fa81f92cdd799e8d96a71aa1092","file_service_id":"file_00000000a200822f8adda3612bb7d948","single_member":"tested-source-usb-controller-regression.json"},{"artifact_id":13593839315,"artifact_name":"pinned-opus-model-acquisition","github_archive_size":674,"github_archive_sha256":"077cdea4b379b110e514a19c58098acd6427e829316fbb3b89e66c13a583f57a","zip_path":"/workspace/build/x6200-freedv-live-gain-20261107.3-r4/ci-recovery/actual-ci-receipts/pinned-opus-model-acquisition.zip","receipt_path":"/workspace/build/x6200-freedv-live-gain-20261107.3-r4/ci-recovery/actual-ci-receipts/pinned-opus-model-acquisition.json","receipt_sha256":"280b4c9a07deadfa4ebb9f5107fe8ed7666d4139b5c1336a531341a944e3921e","file_service_id":"file_000000004678822f92f30120f0a98332","single_member":"model-acquisition.json"},{"artifact_id":13593453557,"artifact_name":"tested-source-linux-inventory","github_archive_size":88795,"github_archive_sha256":"633583f1e1ad8a5235fe66e22c602c5ae2679186719dd7d96c24564e181f6431","zip_path":"/workspace/build/x6200-freedv-live-gain-20261107.3-r4/ci-recovery/actual-ci-receipts/tested-source-linux-inventory.zip","receipt_path":"/workspace/build/x6200-freedv-live-gain-20261107.3-r4/ci-recovery/actual-ci-receipts/tested-source-linux-inventory.json","receipt_sha256":"be5b6514bdc03cdde62c599bd98fcbde02ddb16f5bf9b8a2459a0125bad61b08","file_service_id":"file_00000000f644822f868f5cd450b4f2a0","single_member":"tested-source-linux-inventory.json"},{"artifact_id":13593223407,"artifact_name":"tested-source-windows-runner","github_archive_size":88888,"github_archive_sha256":"ca252d104d4fd89bb50f2aff68d2e5193b476f00f0618fdafd641fcee83a187c","zip_path":"/workspace/build/x6200-freedv-live-gain-20261107.3-r4/ci-recovery/actual-ci-receipts/tested-source-windows-runner.zip","receipt_path":"/workspace/build/x6200-freedv-live-gain-20261107.3-r4/ci-recovery/actual-ci-receipts/tested-source-windows-runner.json","receipt_sha256":"87d75b86e251cf813a19e51a5b27005bbeea51ca5e8d2b45079424aaa2c0f301","file_service_id":"file_00000000ea40822fb2c4745d136a3e8d","single_member":"tested-source-windows-runner.json"}]}},"verification_scope":"Actual GitHub terminal API, all three clean 1921-file source receipts with identical recomputed tree, exact reviewed external workflow, source-bound pinned-model acquisition and byte-identical cache provenance. Downloaded only four small receipt ZIPs; each ZIP size and SHA256 matched GitHub artifact metadata. Cached model tar rehash remains final release verifier responsibility.","historical_ci_records":[{"path":"/workspace/build/x6200-freedv-live-gain-20261107.3-r4/ci-recovery/historical-145f-ci-files.json","sha256":"b0fe0ea848b1a4f5ba566828a7e86a1a5b08a33617e60757d1a77df3451f891b","current_qualification_credit":false}]},"helper_ci_result_sha256":"0526fff179dc80cecef2411b2555adbf5ac35318fc8403f5f9e6a2f376677d5f","helper_ci_workflow_text":"# External CI only. Every job tests clean frozen product 9688d21cbf360ad14acf059e7df304b5dba9a1ec.\nname: Frozen FreeDV live gain source with retained stop request timing\npermissions:\n  contents: read\njobs:\n  linux-inventory:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n    steps:\n    - name: Use canonical LF bytes before checkout\n      shell: bash\n      run: |\n        git config --global core.autocrlf false\n    - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683\n      with:\n        ref: 9688d21cbf360ad14acf059e7df304b5dba9a1ec\n    - name: Assert and record actual frozen product source\n      shell: python {0}\n      run: |\n        import hashlib\n        import json\n        import os\n        from pathlib import Path\n        import stat\n        import subprocess\n\n        expected = os.environ['TESTED_SOURCE_COMMIT']\n        actual = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()\n        if actual != expected:\n            raise SystemExit('Checkout is not the frozen product commit: ' + actual)\n        dirty = subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=all'], text=True)\n        if dirty:\n            raise SystemExit('Frozen source checkout is dirty: ' + dirty)\n        staged = subprocess.check_output(['git', 'ls-files', '--stage', '-z']).decode().split('\\0')\n        files, skipped_gitlinks = {}, []\n        for entry in staged:\n            if not entry:\n                continue\n            header, name = entry.split('\\t', 1)\n            mode, object_id, stage = header.split()\n            if stage != '0':\n                raise SystemExit('Unmerged source index: ' + name)\n            if mode == '160000':\n                skipped_gitlinks.append(name)\n                continue\n            path = Path(name)\n            if mode not in ('100644', '100755') or not stat.S_ISREG(path.lstat().st_mode):\n                raise SystemExit('Unexpected tracked nonregular file: ' + name)\n            with path.open('rb') as stream:\n                files[name] = hashlib.file_digest(stream, 'sha256').hexdigest()\n        files = dict(sorted(files.items()))\n        tree = hashlib.sha256(''.join(digest + '  ' + name + '\\n' for name, digest in files.items()).encode()).hexdigest()\n        receipt = {\n            'schema': 'x6200.usb.ci-tested-source.v1',\n            'source_commit': actual,\n            'expected_source_commit': expected,\n            'source_worktree_dirty': False,\n            'source_files': files,\n            'source_file_count': len(files),\n            'source_tree_sha256': tree,\n            'skipped_gitlinks': sorted(skipped_gitlinks),\n            'workflow_commit': os.environ['GITHUB_SHA'],\n            'workflow_ref': os.environ['GITHUB_WORKFLOW_REF'],\n            'job': os.environ['GITHUB_JOB'],\n            'run_id': os.environ['GITHUB_RUN_ID'],\n            'run_attempt': os.environ['GITHUB_RUN_ATTEMPT'],\n        }\n        output = Path(os.environ['RUNNER_TEMP']) / ('tested-source-' + os.environ['GITHUB_JOB'] + '.json')\n        output.write_text(json.dumps(receipt, indent=2) + '\\n', encoding='utf-8')\n        print(json.dumps({key: value for key, value in receipt.items() if key != 'source_files'}, sort_keys=True))\n        print('Source receipt: ' + str(output))\n    - name: Install host unit and private audio test dependencies\n      timeout-minutes: 10\n      run: |\n        python3 tools/freedv/test_ci_ubuntu_sources.py\n        sudo python3 tools/freedv/ci_ubuntu_sources.py\n        task_apt_options=(-o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::Retries=2)\n        sudo apt-get \"${task_apt_options[@]}\" update\n        sudo env DEBIAN_FRONTEND=noninteractive apt-get \"${task_apt_options[@]}\" install -y --no-install-recommends \\\n          build-essential binutils e2fsprogs libpulse-dev libsamplerate0-dev pulseaudio pulseaudio-utils python3-venv\n        # Host-only preview waveform observer; never installed on the radio.\n        python3 -m venv \"$RUNNER_TEMP/usb-observer-python\"\n        \"$RUNNER_TEMP/usb-observer-python/bin/python\" -m pip install --disable-pip-version-check --only-binary=:all: numpy==2.3.5\n        echo \"$RUNNER_TEMP/usb-observer-python/bin\" >> \"$GITHUB_PATH\"\n    - name: Check USB duplex endpoint identification without devices\n      run: python tools/freedv/test_usb_headset_inventory.py\n    - name: Check validation guards and partial evidence\n      run: |\n        python tools/freedv/test_usb_headset_validate.py\n        python tools/freedv/test_usb_half_duplex.py\n        python tools/freedv/test_usb_rf_evidence.py\n        python tools/freedv/test_usb_test_support.py\n        python -O tools/freedv/test_usb_test_support.py\n        python tools/freedv/test_usb_output_contract.py\n        python -O tools/freedv/test_usb_output_contract.py\n        python tools/freedv/test_usb_capture_open_contract.py\n        python -O tools/freedv/test_usb_capture_open_contract.py\n        python tools/freedv/test_usb_refinement_contract.py\n        python -O tools/freedv/test_usb_refinement_contract.py\n        python tools/freedv/test_usb_fifo_clock.py\n        python tools/freedv/test_usb_backend_observer.py\n        python -O tools/freedv/test_usb_backend_observer.py\n        python tools/freedv/test_usb_campaign.py\n        python tools/freedv/test_usb_host_resources.py\n        python tools/freedv/test_usb_controller_build.py\n        python tools/freedv/test_usb_ci_diagnostics.py\n        python tools/freedv/test_usb_navigation_service.py\n        python tools/freedv/test_native_image.py\n    - name: Check PCM streams and endpoint loss on private virtual devices\n      run: |\n        gcc -std=c11 -Wall -Wextra -Werror -O2 tools/freedv/usb_headset_pcm.c -lpulse -o /tmp/usb_headset_pcm\n        gcc -std=c11 -Wall -Wextra -Werror -fsyntax-only tools/freedv/usb_half_duplex.c\n        gcc -std=c11 -Wall -Wextra -Werror -fsyntax-only src/freedv/usb_audio.c\n        gcc -std=c11 -Wall -Wextra -Werror -DHOST_BUILD=1 -fsyntax-only src/freedv/usb_audio.c\n        gcc -std=c11 -Wall -Wextra -Werror tools/freedv/usb_panel_test.c -o /tmp/usb_panel_test\n        /tmp/usb_panel_test\n        gcc -std=c11 -Wall -Wextra -Werror tools/freedv/usb_audio_levels_test.c -lm -o /tmp/usb_audio_levels_test\n        /tmp/usb_audio_levels_test\n        gcc -std=c11 -Wall -Wextra -Werror -I. tools/freedv/usb_render_budget_test.c -lsamplerate -lm -o /tmp/usb_render_budget_test\n        /tmp/usb_render_budget_test\n        gcc -std=c11 -Wall -Wextra -Werror -fPIC -shared tools/freedv/test_usb_headset_drop_drain.c -lpulse -ldl -o /tmp/drop-drain.so\n        TEST_PULSE_DROP_DRAIN_ACK_SO=/tmp/drop-drain.so python tools/freedv/test_usb_headset_pcm.py /tmp/usb_headset_pcm\n    - name: Retain actual tested-source receipt\n      if: always()\n      uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n      with:\n        name: tested-source-linux-inventory\n        retention-days: 14\n        if-no-files-found: error\n        path: ${{ runner.temp }}/tested-source-linux-inventory.json\n  usb-controller-regression:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 75\n    steps:\n    - name: Use canonical LF bytes before checkout\n      shell: bash\n      run: |\n        git config --global core.autocrlf false\n    - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683\n      with:\n        fetch-depth: 0\n        ref: 9688d21cbf360ad14acf059e7df304b5dba9a1ec\n    - name: Assert and record actual frozen product source\n      shell: python {0}\n      run: |\n        import hashlib\n        import json\n        import os\n        from pathlib import Path\n        import stat\n        import subprocess\n\n        expected = os.environ['TESTED_SOURCE_COMMIT']\n        actual = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()\n        if actual != expected:\n            raise SystemExit('Checkout is not the frozen product commit: ' + actual)\n        dirty = subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=all'], text=True)\n        if dirty:\n            raise SystemExit('Frozen source checkout is dirty: ' + dirty)\n        staged = subprocess.check_output(['git', 'ls-files', '--stage', '-z']).decode().split('\\0')\n        files, skipped_gitlinks = {}, []\n        for entry in staged:\n            if not entry:\n                continue\n            header, name = entry.split('\\t', 1)\n            mode, object_id, stage = header.split()\n            if stage != '0':\n                raise SystemExit('Unmerged source index: ' + name)\n            if mode == '160000':\n                skipped_gitlinks.append(name)\n                continue\n            path = Path(name)\n            if mode not in ('100644', '100755') or not stat.S_ISREG(path.lstat().st_mode):\n                raise SystemExit('Unexpected tracked nonregular file: ' + name)\n            with path.open('rb') as stream:\n                files[name] = hashlib.file_digest(stream, 'sha256').hexdigest()\n        files = dict(sorted(files.items()))\n        tree = hashlib.sha256(''.join(digest + '  ' + name + '\\n' for name, digest in files.items()).encode()).hexdigest()\n        receipt = {\n            'schema': 'x6200.usb.ci-tested-source.v1',\n            'source_commit': actual,\n            'expected_source_commit': expected,\n            'source_worktree_dirty': False,\n            'source_files': files,\n            'source_file_count': len(files),\n            'source_tree_sha256': tree,\n            'skipped_gitlinks': sorted(skipped_gitlinks),\n            'workflow_commit': os.environ['GITHUB_SHA'],\n            'workflow_ref': os.environ['GITHUB_WORKFLOW_REF'],\n            'job': os.environ['GITHUB_JOB'],\n            'run_id': os.environ['GITHUB_RUN_ID'],\n            'run_attempt': os.environ['GITHUB_RUN_ATTEMPT'],\n        }\n        output = Path(os.environ['RUNNER_TEMP']) / ('tested-source-' + os.environ['GITHUB_JOB'] + '.json')\n        output.write_text(json.dumps(receipt, indent=2) + '\\n', encoding='utf-8')\n        print(json.dumps({key: value for key, value in receipt.items() if key != 'source_files'}, sort_keys=True))\n        print('Source receipt: ' + str(output))\n    - name: Install pinned-codec and private audio test build prerequisites\n      timeout-minutes: 10\n      run: |\n        python3 tools/freedv/test_ci_ubuntu_sources.py\n        sudo python3 tools/freedv/ci_ubuntu_sources.py\n        task_apt_options=(-o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::Retries=2)\n        sudo apt-get \"${task_apt_options[@]}\" update\n        sudo env DEBIAN_FRONTEND=noninteractive apt-get \"${task_apt_options[@]}\" install -y --no-install-recommends \\\n          build-essential cmake ninja-build autoconf automake libtool pkg-config \\\n          libpulse-dev libsamplerate0-dev libsndfile1-dev pulseaudio pulseaudio-utils python3-venv\n        python3 -m venv \"$RUNNER_TEMP/usb-observer-python\"\n        \"$RUNNER_TEMP/usb-observer-python/bin/python\" -m pip install --disable-pip-version-check --only-binary=:all: numpy==2.3.5\n        echo \"$RUNNER_TEMP/usb-observer-python/bin\" >> \"$GITHUB_PATH\"\n    - name: Acquire exact pinned Opus model through verified cache\n      timeout-minutes: 10\n      shell: bash\n      run: |\n        set -euo pipefail\n        model_name=\"opus_data-${OPUS_MODEL_SHA256}.tar.gz\"\n        model_dir=\"$RUNNER_TEMP/verified-opus-model\"\n        mkdir -p \"$model_dir\" \"$RUNNER_TEMP/model-download-bin\"\n        model_path=\"$model_dir/$model_name\"\n        export OPUS_PINNED_MODEL_PATH=\"$model_path\"\n        python3 - <<'PYMODEL'\n        import hashlib,json,os,subprocess\n        from pathlib import Path\n        expected=os.environ['OPUS_MODEL_SHA256']\n        target=Path(os.environ['OPUS_PINNED_MODEL_PATH'])\n        urls=[os.environ['OPUS_MODEL_CACHE_URL'], 'https://media.xiph.org/opus/models/'+target.name]\n        errors=[]\n        for index,url in enumerate(urls):\n            candidate=target.with_suffix('.candidate')\n            try:\n                outcome=subprocess.run(['curl','--fail','--location','--silent','--show-error',\n                    '--connect-timeout','15','--max-time','240','--retry','1','--retry-max-time','260',\n                    '--output',str(candidate),url],check=False,timeout=270)\n            except subprocess.TimeoutExpired:\n                candidate.unlink(missing_ok=True);errors.append({'url':url,'exit_code':124});continue\n            if outcome.returncode:\n                candidate.unlink(missing_ok=True);errors.append({'url':url,'exit_code':outcome.returncode});continue\n            with candidate.open('rb') as stream:actual=hashlib.file_digest(stream,'sha256').hexdigest()\n            if actual!=expected:\n                candidate.unlink(missing_ok=True)\n                raise SystemExit('Pinned Opus model checksum mismatch from '+url)\n            if candidate.stat().st_size!=183514217:\n                candidate.unlink(missing_ok=True);raise SystemExit('Pinned model size differs')\n            candidate.replace(target)\n            receipt={'schema':'x6200.usb.ci-model-acquisition.v1','source_url':url,\n                'upstream_url':urls[1],'sha256':actual,'expected_sha256':expected,'bytes':target.stat().st_size,\n                'fallback_attempts':errors,'product_source_modified':False,\n                'workflow_commit':os.environ['GITHUB_SHA'],'tested_source_commit':os.environ['TESTED_SOURCE_COMMIT']}\n            (target.parent/'model-acquisition.json').write_text(json.dumps(receipt,indent=2)+'\\n')\n            print(json.dumps(receipt,sort_keys=True));break\n        else:raise SystemExit('Pinned Opus model acquisition failed: '+json.dumps(errors))\n        PYMODEL\n        cat > \"$RUNNER_TEMP/model-download-bin/wget\" <<'SHMODEL'\n        #!/usr/bin/env bash\n        set -euo pipefail\n        expected_name=\"opus_data-${OPUS_MODEL_SHA256}.tar.gz\"\n        expected_url=\"https://media.xiph.org/opus/models/${expected_name}\"\n        if [[ \"$#\" == 3 && \"$1\" == \"-O\" && \"$2\" == \"$expected_name\" && \"$3\" == \"$expected_url\" ]]; then\n          # Supply only the exact previously verified model. The unchanged Opus\n          # download script independently checks its SHA again before extraction.\n          cp -- \"$OPUS_PINNED_MODEL_PATH\" \"$2\"\n          printf 'Verified pinned Opus model supplied from cache: %s\\n' \"$OPUS_MODEL_SHA256\"\n        else\n          exec /usr/bin/wget \"$@\"\n        fi\n        SHMODEL\n        chmod 755 \"$RUNNER_TEMP/model-download-bin/wget\"\n        printf '%s\\n' \"$RUNNER_TEMP/model-download-bin\" >> \"$GITHUB_PATH\"\n        printf 'OPUS_PINNED_MODEL_PATH=%s\\n' \"$model_path\" >> \"$GITHUB_ENV\"\n        python3 - <<'PYSHIMRECEIPT'\n        import hashlib,json,os\n        from pathlib import Path\n        root=Path(os.environ['RUNNER_TEMP'])\n        receipt_path=root/'verified-opus-model/model-acquisition.json'\n        receipt=json.loads(receipt_path.read_text())\n        shim=root/'model-download-bin/wget'\n        receipt.update(shim_sha256=hashlib.sha256(shim.read_bytes()).hexdigest(),\n            shim_scope='Only exact pinned official model URL and output basename; all other invocations delegate /usr/bin/wget',\n            unchanged_opus_self_verification=True)\n        receipt_path.write_text(json.dumps(receipt,indent=2)+'\\n')\n        print(json.dumps(receipt,sort_keys=True))\n        PYSHIMRECEIPT\n    - name: Build exact production controller and codec runner without the GUI\n      timeout-minutes: 25\n      run: |\n        python3 tools/freedv/build_usb_controller_host.py --prepare-codec \\\n          --work \"$RUNNER_TEMP/usb-controller-build\" --jobs 2 \\\n          --build-id \"usb-controller-ci-${GITHUB_SHA}\" \\\n          > \"$RUNNER_TEMP/usb-controller-build.log\" 2>&1 || {\n            task_status=$?\n            python3 tools/freedv/usb_ci_diagnostics.py --work-root \"$RUNNER_TEMP\"\n            exit \"$task_status\"\n          }\n    - name: Run complete controller regression and lifecycle cases on private PulseAudio\n      timeout-minutes: 30\n      run: |\n        export LD_LIBRARY_PATH=\"$RUNNER_TEMP/usb-controller-build/codec/rade_c/src${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\"\n        python3 tools/freedv/test_usb_audio_matrix.py \\\n          \"$RUNNER_TEMP/usb-controller-build/freedv_usb_audio_test\" \\\n          \"$RUNNER_TEMP/usb-controller-build/codec/sources/rade_c/input_sample.wav\" \\\n          \"$RUNNER_TEMP/usb-controller-build/usb-reference-48k.raw\" \\\n          --runner \"$RUNNER_TEMP/usb-controller-build/freedv_voice_runner\" \\\n          --rade-library \"$RUNNER_TEMP/usb-controller-build/codec/rade_c/src/librade.so.0.1\" \\\n          --output \"$RUNNER_TEMP/usb-controller-matrix\" --profile regression \\\n          --campaign-root \"$RUNNER_TEMP/usb-controller-campaigns\" \\\n          --source-commit \"$TESTED_SOURCE_COMMIT\" --build-id \"usb-controller-ci-${GITHUB_SHA}\" \\\n          > \"$RUNNER_TEMP/usb-controller-matrix.log\" 2>&1 || {\n            task_status=$?\n            python3 tools/freedv/usb_ci_diagnostics.py --work-root \"$RUNNER_TEMP\"\n            exit \"$task_status\"\n          }\n    - name: Retain bounded PCM only from failed public-fixture cases\n      if: failure()\n      timeout-minutes: 2\n      run: |\n        python3 tools/freedv/usb_ci_diagnostics.py --work-root \"$RUNNER_TEMP\" \\\n          --output \"$RUNNER_TEMP/usb-controller-failure-fixtures\"\n    - name: Retain successful and failed build/campaign evidence\n      if: always()\n      uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n      with:\n        name: usb-controller-evidence-${{ github.run_id }}-${{ github.run_attempt }}\n        retention-days: 14\n        if-no-files-found: warn\n        path: |\n          ${{ runner.temp }}/usb-controller-build.log\n          ${{ runner.temp }}/usb-controller-build/build-record.json\n          ${{ runner.temp }}/usb-controller-build/*.log\n          ${{ runner.temp }}/usb-controller-matrix.log\n          ${{ runner.temp }}/usb-controller-matrix/**/*.json\n          ${{ runner.temp }}/usb-controller-matrix/**/*.jsonl\n          ${{ runner.temp }}/usb-controller-matrix/**/*.log\n          ${{ runner.temp }}/usb-controller-matrix/**/*.txt\n          ${{ runner.temp }}/usb-controller-matrix/**/default.pa\n          ${{ runner.temp }}/usb-controller-campaigns/**/*.json\n          ${{ runner.temp }}/usb-controller-failure-fixtures/\n    - name: Retain actual tested-source receipt\n      if: always()\n      uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n      with:\n        name: tested-source-usb-controller-regression\n        retention-days: 14\n        if-no-files-found: error\n        path: ${{ runner.temp }}/tested-source-usb-controller-regression.json\n    - name: Retain pinned model acquisition receipt\n      if: always()\n      uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n      with:\n        name: pinned-opus-model-acquisition\n        retention-days: 14\n        if-no-files-found: warn\n        path: ${{ runner.temp }}/verified-opus-model/model-acquisition.json\n  windows-runner:\n    runs-on: windows-latest\n    timeout-minutes: 15\n    steps:\n    - name: Use canonical LF bytes before checkout\n      shell: bash\n      run: |\n        git config --global core.autocrlf false\n    - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683\n      with:\n        ref: 9688d21cbf360ad14acf059e7df304b5dba9a1ec\n    - name: Assert and record actual frozen product source\n      shell: python {0}\n      run: |\n        import hashlib\n        import json\n        import os\n        from pathlib import Path\n        import stat\n        import subprocess\n\n        expected = os.environ['TESTED_SOURCE_COMMIT']\n        actual = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()\n        if actual != expected:\n            raise SystemExit('Checkout is not the frozen product commit: ' + actual)\n        dirty = subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=all'], text=True)\n        if dirty:\n            raise SystemExit('Frozen source checkout is dirty: ' + dirty)\n        staged = subprocess.check_output(['git', 'ls-files', '--stage', '-z']).decode().split('\\0')\n        files, skipped_gitlinks = {}, []\n        for entry in staged:\n            if not entry:\n                continue\n            header, name = entry.split('\\t', 1)\n            mode, object_id, stage = header.split()\n            if stage != '0':\n                raise SystemExit('Unmerged source index: ' + name)\n            if mode == '160000':\n                skipped_gitlinks.append(name)\n                continue\n            path = Path(name)\n            if mode not in ('100644', '100755') or not stat.S_ISREG(path.lstat().st_mode):\n                raise SystemExit('Unexpected tracked nonregular file: ' + name)\n            with path.open('rb') as stream:\n                files[name] = hashlib.file_digest(stream, 'sha256').hexdigest()\n        files = dict(sorted(files.items()))\n        tree = hashlib.sha256(''.join(digest + '  ' + name + '\\n' for name, digest in files.items()).encode()).hexdigest()\n        receipt = {\n            'schema': 'x6200.usb.ci-tested-source.v1',\n            'source_commit': actual,\n            'expected_source_commit': expected,\n            'source_worktree_dirty': False,\n            'source_files': files,\n            'source_file_count': len(files),\n            'source_tree_sha256': tree,\n            'skipped_gitlinks': sorted(skipped_gitlinks),\n            'workflow_commit': os.environ['GITHUB_SHA'],\n            'workflow_ref': os.environ['