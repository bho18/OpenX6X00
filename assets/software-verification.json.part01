reedv/sources.json","purpose":"Byte-identical public Opus model cache for reproducible CI. No model or firmware changes.","license_reference":"COPYING","verification":"Expected SHA is pinned in source and independently enforced by the unchanged Opus download script and benchmark builder."},"scope":"All four assets freshly downloaded; API digests, pinned model bytes and published SHA256SUMS agree"}},"model_acquisition_receipt":{"path":"/workspace/build/x6200-freedv-hardening-20261107.2/ci-recovery/receipts-42401661285-plugin/model-acquisition.json","sha256":"51d786ec4295e66717a45d4a76cb3395ec511e5a762ff5c4de75a76c453d26f3","receipt":{"schema":"x6200.usb.ci-model-acquisition.v1","source_url":"https://github.com/bho18/OpenX6X00/releases/download/freedv-dependency-model-4ed9445b/opus_data-4ed9445b96698bad25d852e912b41495ddfa30c8dbc8a55f9cde5826ed793453.tar.gz","upstream_url":"https://media.xiph.org/opus/models/opus_data-4ed9445b96698bad25d852e912b41495ddfa30c8dbc8a55f9cde5826ed793453.tar.gz","sha256":"4ed9445b96698bad25d852e912b41495ddfa30c8dbc8a55f9cde5826ed793453","expected_sha256":"4ed9445b96698bad25d852e912b41495ddfa30c8dbc8a55f9cde5826ed793453","bytes":183514217,"fallback_attempts":[],"product_source_modified":false,"workflow_commit":"0ea90c8a77808629b329af5553c7b749e0594d13","tested_source_commit":"20cf0e65fecb6459fc8c7d6d40d65b514b82a11c","shim_sha256":"eeffd9089007977ee1080587d2bfa92af8a9be89199b898644be121bdeac0ed0","shim_scope":"Only exact pinned official model URL and output basename; all other invocations delegate /usr/bin/wget","unchanged_opus_self_verification":true}},"model_shim":{"path":"/workspace/build/x6200-freedv-hardening-20261107.2/ci-recovery/wget-shim","sha256":"eeffd9089007977ee1080587d2bfa92af8a9be89199b898644be121bdeac0ed0"},"artifact_transport":{"path":"/workspace/build/x6200-freedv-hardening-20261107.2/ci-recovery/plugin-receipt-downloads.json","sha256":"98bb6fffeb10b30cbfdcbb475fc53cf7aba568de6718b09f119cfb6ae1914acc","receipt":{"status":"PASS","transport":"GitHub plugin workflow-artifact download followed by reusable file reference","artifacts":[{"artifact_id":13586127722,"artifact_name":"tested-source-usb-controller-regression","zip_path":"/workspace/build/x6200-freedv-hardening-20261107.2/ci-recovery/receipts-42401661285-plugin/tested-source-usb-controller-regression.zip","zip_sha256":"b0023d34c69d7bc58c4ca65a44fe37a9c07a5d24d5bc4adfd83700751a7cc210","file_service_id":"file_0000000049ac822f8bd31ee0e4f78a4f","file_path":"/workspace/build/x6200-freedv-hardening-20261107.2/ci-recovery/receipts-42401661285-plugin/tested-source-usb-controller-regression.json","file_sha256":"1d47bb190ceaae9490e828b1a4d89537d4f0b3ca4b5634e2f3d42a5768b56bbf"},{"artifact_id":13585913644,"artifact_name":"pinned-opus-model-acquisition","zip_path":"/workspace/build/x6200-freedv-hardening-20261107.2/ci-recovery/receipts-42401661285-plugin/pinned-opus-model-acquisition.zip","zip_sha256":"2700ebd8d0131b8fe6ff5fe162a1a2409c805789576bf275c67e0dce07ad9f59","file_service_id":"file_000000005e5c822fba5dab4eb273eaf2","file_path":"/workspace/build/x6200-freedv-hardening-20261107.2/ci-recovery/receipts-42401661285-plugin/model-acquisition.json","file_sha256":"51d786ec4295e66717a45d4a76cb3395ec511e5a762ff5c4de75a76c453d26f3"},{"artifact_id":13585682742,"artifact_name":"tested-source-linux-inventory","zip_path":"/workspace/build/x6200-freedv-hardening-20261107.2/ci-recovery/receipts-42401661285-plugin/tested-source-linux-inventory.zip","zip_sha256":"42201740c16d0e4e02aa2a58afd41a281617a7daf6e24e8e0e6baba70b8dc709","file_service_id":"file_00000000a544822fb4fad63ee1292325","file_path":"/workspace/build/x6200-freedv-hardening-20261107.2/ci-recovery/receipts-42401661285-plugin/tested-source-linux-inventory.json","file_sha256":"c78f6ce170c3bacd3d129ad5e423c73f9d284de380cdd8d97dbfadb250d81cad"},{"artifact_id":13584839159,"artifact_name":"tested-source-windows-runner","zip_path":"/workspace/build/x6200-freedv-hardening-20261107.2/ci-recovery/receipts-42401661285-plugin/tested-source-windows-runner.zip","zip_sha256":"1461d8af9e67173c8a6ff7ec7ac5703e5cecef5ea992b5105ac4ef265b9171cc","file_service_id":"file_00000000bc80822fb5049b95c9fe17e7","file_path":"/workspace/build/x6200-freedv-hardening-20261107.2/ci-recovery/receipts-42401661285-plugin/tested-source-windows-runner.json","file_sha256":"36a86c23ef8ef8c1537f16a7ecd48a54c804f85617163838b1d9a9a1eff95d5e"}]}},"verification_scope":"All three raw receipt file maps equal the exact clean local frozen product snapshot","preserved_failed_runs":[{"run_id":42399856238,"cause":"Upstream pinned Opus model download unavailable; controller build/matrix not run"},{"run_id":42401217906,"workflow_commit":"3ba0823f0843d59bb2a57de758d44f4e7b7f3f16","cause":"External workflow requested workflow SHA instead of tested source SHA; matrix refused before cases"}]},"helper_ci_result_sha256":"ecaeccc945926e2e0a6fd5abecd38c15635e94720190106d18f79b2b85509959","helper_ci_workflow_text":"# External CI infrastructure recovery. All jobs test clean frozen product 20cf0e65fecb6459fc8c7d6d40d65b514b82a11c.\nname: Frozen FreeDV hardening source with pinned model cache\npermissions:\n  contents: read\njobs:\n  linux-inventory:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 20\n    steps:\n    - name: Use canonical LF bytes before checkout\n      shell: bash\n      run: |\n        git config --global core.autocrlf false\n    - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683\n      with:\n        ref: 20cf0e65fecb6459fc8c7d6d40d65b514b82a11c\n    - name: Assert and record actual frozen product source\n      shell: python {0}\n      run: |\n        import hashlib\n        import json\n        import os\n        from pathlib import Path\n        import stat\n        import subprocess\n\n        expected = os.environ['TESTED_SOURCE_COMMIT']\n        actual = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()\n        if actual != expected:\n            raise SystemExit('Checkout is not the frozen product commit: ' + actual)\n        dirty = subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=all'], text=True)\n        if dirty:\n            raise SystemExit('Frozen source checkout is dirty: ' + dirty)\n        staged = subprocess.check_output(['git', 'ls-files', '--stage', '-z']).decode().split('\\0')\n        files, skipped_gitlinks = {}, []\n        for entry in staged:\n            if not entry:\n                continue\n            header, name = entry.split('\\t', 1)\n            mode, object_id, stage = header.split()\n            if stage != '0':\n                raise SystemExit('Unmerged source index: ' + name)\n            if mode == '160000':\n                skipped_gitlinks.append(name)\n                continue\n            path = Path(name)\n            if mode not in ('100644', '100755') or not stat.S_ISREG(path.lstat().st_mode):\n                raise SystemExit('Unexpected tracked nonregular file: ' + name)\n            with path.open('rb') as stream:\n                files[name] = hashlib.file_digest(stream, 'sha256').hexdigest()\n        files = dict(sorted(files.items()))\n        tree = hashlib.sha256(''.join(digest + '  ' + name + '\\n' for name, digest in files.items()).encode()).hexdigest()\n        receipt = {\n            'schema': 'x6200.usb.ci-tested-source.v1',\n            'source_commit': actual,\n            'expected_source_commit': expected,\n            'source_worktree_dirty': False,\n            'source_files': files,\n            'source_file_count': len(files),\n            'source_tree_sha256': tree,\n            'skipped_gitlinks': sorted(skipped_gitlinks),\n            'workflow_commit': os.environ['GITHUB_SHA'],\n            'workflow_ref': os.environ['GITHUB_WORKFLOW_REF'],\n            'job': os.environ['GITHUB_JOB'],\n            'run_id': os.environ['GITHUB_RUN_ID'],\n            'run_attempt': os.environ['GITHUB_RUN_ATTEMPT'],\n        }\n        output = Path(os.environ['RUNNER_TEMP']) / ('tested-source-' + os.environ['GITHUB_JOB'] + '.json')\n        output.write_text(json.dumps(receipt, indent=2) + '\\n', encoding='utf-8')\n        print(json.dumps({key: value for key, value in receipt.items() if key != 'source_files'}, sort_keys=True))\n        print('Source receipt: ' + str(output))\n    - name: Install host unit and private audio test dependencies\n      timeout-minutes: 10\n      run: |\n        python3 tools/freedv/test_ci_ubuntu_sources.py\n        sudo python3 tools/freedv/ci_ubuntu_sources.py\n        task_apt_options=(-o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::Retries=2)\n        sudo apt-get \"${task_apt_options[@]}\" update\n        sudo env DEBIAN_FRONTEND=noninteractive apt-get \"${task_apt_options[@]}\" install -y --no-install-recommends \\\n          build-essential binutils e2fsprogs libpulse-dev libsamplerate0-dev pulseaudio pulseaudio-utils python3-venv\n        # Host-only preview waveform observer; never installed on the radio.\n        python3 -m venv \"$RUNNER_TEMP/usb-observer-python\"\n        \"$RUNNER_TEMP/usb-observer-python/bin/python\" -m pip install --disable-pip-version-check --only-binary=:all: numpy==2.3.5\n        echo \"$RUNNER_TEMP/usb-observer-python/bin\" >> \"$GITHUB_PATH\"\n    - name: Check USB duplex endpoint identification without devices\n      run: python tools/freedv/test_usb_headset_inventory.py\n    - name: Check validation guards and partial evidence\n      run: |\n        python tools/freedv/test_usb_headset_validate.py\n        python tools/freedv/test_usb_half_duplex.py\n        python tools/freedv/test_usb_rf_evidence.py\n        python tools/freedv/test_usb_test_support.py\n        python -O tools/freedv/test_usb_test_support.py\n        python tools/freedv/test_usb_output_contract.py\n        python -O tools/freedv/test_usb_output_contract.py\n        python tools/freedv/test_usb_capture_open_contract.py\n        python -O tools/freedv/test_usb_capture_open_contract.py\n        python tools/freedv/test_usb_refinement_contract.py\n        python -O tools/freedv/test_usb_refinement_contract.py\n        python tools/freedv/test_usb_fifo_clock.py\n        python tools/freedv/test_usb_backend_observer.py\n        python -O tools/freedv/test_usb_backend_observer.py\n        python tools/freedv/test_usb_campaign.py\n        python tools/freedv/test_usb_host_resources.py\n        python tools/freedv/test_usb_controller_build.py\n        python tools/freedv/test_usb_ci_diagnostics.py\n        python tools/freedv/test_usb_navigation_service.py\n        python tools/freedv/test_native_image.py\n    - name: Check PCM streams and endpoint loss on private virtual devices\n      run: |\n        gcc -std=c11 -Wall -Wextra -Werror -O2 tools/freedv/usb_headset_pcm.c -lpulse -o /tmp/usb_headset_pcm\n        gcc -std=c11 -Wall -Wextra -Werror -fsyntax-only tools/freedv/usb_half_duplex.c\n        gcc -std=c11 -Wall -Wextra -Werror -fsyntax-only src/freedv/usb_audio.c\n        gcc -std=c11 -Wall -Wextra -Werror -DHOST_BUILD=1 -fsyntax-only src/freedv/usb_audio.c\n        gcc -std=c11 -Wall -Wextra -Werror tools/freedv/usb_panel_test.c -o /tmp/usb_panel_test\n        /tmp/usb_panel_test\n        gcc -std=c11 -Wall -Wextra -Werror tools/freedv/usb_audio_levels_test.c -lm -o /tmp/usb_audio_levels_test\n        /tmp/usb_audio_levels_test\n        gcc -std=c11 -Wall -Wextra -Werror -I. tools/freedv/usb_render_budget_test.c -lsamplerate -lm -o /tmp/usb_render_budget_test\n        /tmp/usb_render_budget_test\n        gcc -std=c11 -Wall -Wextra -Werror -fPIC -shared tools/freedv/test_usb_headset_drop_drain.c -lpulse -ldl -o /tmp/drop-drain.so\n        TEST_PULSE_DROP_DRAIN_ACK_SO=/tmp/drop-drain.so python tools/freedv/test_usb_headset_pcm.py /tmp/usb_headset_pcm\n    - name: Retain actual tested-source receipt\n      if: always()\n      uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n      with:\n        name: tested-source-linux-inventory\n        retention-days: 14\n        if-no-files-found: error\n        path: ${{ runner.temp }}/tested-source-linux-inventory.json\n  usb-controller-regression:\n    runs-on: ubuntu-24.04\n    timeout-minutes: 75\n    steps:\n    - name: Use canonical LF bytes before checkout\n      shell: bash\n      run: |\n        git config --global core.autocrlf false\n    - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683\n      with:\n        fetch-depth: 0\n        ref: 20cf0e65fecb6459fc8c7d6d40d65b514b82a11c\n    - name: Assert and record actual frozen product source\n      shell: python {0}\n      run: |\n        import hashlib\n        import json\n        import os\n        from pathlib import Path\n        import stat\n        import subprocess\n\n        expected = os.environ['TESTED_SOURCE_COMMIT']\n        actual = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()\n        if actual != expected:\n            raise SystemExit('Checkout is not the frozen product commit: ' + actual)\n        dirty = subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=all'], text=True)\n        if dirty:\n            raise SystemExit('Frozen source checkout is dirty: ' + dirty)\n        staged = subprocess.check_output(['git', 'ls-files', '--stage', '-z']).decode().split('\\0')\n        files, skipped_gitlinks = {}, []\n        for entry in staged:\n            if not entry:\n                continue\n            header, name = entry.split('\\t', 1)\n            mode, object_id, stage = header.split()\n            if stage != '0':\n                raise SystemExit('Unmerged source index: ' + name)\n            if mode == '160000':\n                skipped_gitlinks.append(name)\n                continue\n            path = Path(name)\n            if mode not in ('100644', '100755') or not stat.S_ISREG(path.lstat().st_mode):\n                raise SystemExit('Unexpected tracked nonregular file: ' + name)\n            with path.open('rb') as stream:\n                files[name] = hashlib.file_digest(stream, 'sha256').hexdigest()\n        files = dict(sorted(files.items()))\n        tree = hashlib.sha256(''.join(digest + '  ' + name + '\\n' for name, digest in files.items()).encode()).hexdigest()\n        receipt = {\n            'schema': 'x6200.usb.ci-tested-source.v1',\n            'source_commit': actual,\n            'expected_source_commit': expected,\n            'source_worktree_dirty': False,\n            'source_files': files,\n            'source_file_count': len(files),\n            'source_tree_sha256': tree,\n            'skipped_gitlinks': sorted(skipped_gitlinks),\n            'workflow_commit': os.environ['GITHUB_SHA'],\n            'workflow_ref': os.environ['GITHUB_WORKFLOW_REF'],\n            'job': os.environ['GITHUB_JOB'],\n            'run_id': os.environ['GITHUB_RUN_ID'],\n            'run_attempt': os.environ['GITHUB_RUN_ATTEMPT'],\n        }\n        output = Path(os.environ['RUNNER_TEMP']) / ('tested-source-' + os.environ['GITHUB_JOB'] + '.json')\n        output.write_text(json.dumps(receipt, indent=2) + '\\n', encoding='utf-8')\n        print(json.dumps({key: value for key, value in receipt.items() if key != 'source_files'}, sort_keys=True))\n        print('Source receipt: ' + str(output))\n    - name: Install pinned-codec and private audio test build prerequisites\n      timeout-minutes: 10\n      run: |\n        python3 tools/freedv/test_ci_ubuntu_sources.py\n        sudo python3 tools/freedv/ci_ubuntu_sources.py\n        task_apt_options=(-o Acquire::http::Timeout=30 -o Acquire::https::Timeout=30 -o Acquire::Retries=2)\n        sudo apt-get \"${task_apt_options[@]}\" update\n        sudo env DEBIAN_FRONTEND=noninteractive apt-get \"${task_apt_options[@]}\" install -y --no-install-recommends \\\n          build-essential cmake ninja-build autoconf automake libtool pkg-config \\\n          libpulse-dev libsamplerate0-dev libsndfile1-dev pulseaudio pulseaudio-utils python3-venv\n        python3 -m venv \"$RUNNER_TEMP/usb-observer-python\"\n        \"$RUNNER_TEMP/usb-observer-python/bin/python\" -m pip install --disable-pip-version-check --only-binary=:all: numpy==2.3.5\n        echo \"$RUNNER_TEMP/usb-observer-python/bin\" >> \"$GITHUB_PATH\"\n    - name: Acquire exact pinned Opus model through verified cache\n      timeout-minutes: 10\n      shell: bash\n      run: |\n        set -euo pipefail\n        model_name=\"opus_data-${OPUS_MODEL_SHA256}.tar.gz\"\n        model_dir=\"$RUNNER_TEMP/verified-opus-model\"\n        mkdir -p \"$model_dir\" \"$RUNNER_TEMP/model-download-bin\"\n        model_path=\"$model_dir/$model_name\"\n        export OPUS_PINNED_MODEL_PATH=\"$model_path\"\n        python3 - <<'PYMODEL'\n        import hashlib,json,os,subprocess\n        from pathlib import Path\n        expected=os.environ['OPUS_MODEL_SHA256']\n        target=Path(os.environ['OPUS_PINNED_MODEL_PATH'])\n        urls=[os.environ['OPUS_MODEL_CACHE_URL'], 'https://media.xiph.org/opus/models/'+target.name]\n        errors=[]\n        for index,url in enumerate(urls):\n            candidate=target.with_suffix('.candidate')\n            try:\n                outcome=subprocess.run(['curl','--fail','--location','--silent','--show-error',\n                    '--connect-timeout','15','--max-time','240','--retry','1','--retry-max-time','260',\n                    '--output',str(candidate),url],check=False,timeout=270)\n            except subprocess.TimeoutExpired:\n                candidate.unlink(missing_ok=True);errors.append({'url':url,'exit_code':124});continue\n            if outcome.returncode:\n                candidate.unlink(missing_ok=True);errors.append({'url':url,'exit_code':outcome.returncode});continue\n            with candidate.open('rb') as stream:actual=hashlib.file_digest(stream,'sha256').hexdigest()\n            if actual!=expected:\n                candidate.unlink(missing_ok=True)\n                raise SystemExit('Pinned Opus model checksum mismatch from '+url)\n            if candidate.stat().st_size!=183514217:\n                candidate.unlink(missing_ok=True);raise SystemExit('Pinned model size differs')\n            candidate.replace(target)\n            receipt={'schema':'x6200.usb.ci-model-acquisition.v1','source_url':url,\n                'upstream_url':urls[1],'sha256':actual,'expected_sha256':expected,'bytes':target.stat().st_size,\n                'fallback_attempts':errors,'product_source_modified':False,\n                'workflow_commit':os.environ['GITHUB_SHA'],'tested_source_commit':os.environ['TESTED_SOURCE_COMMIT']}\n            (target.parent/'model-acquisition.json').write_text(json.dumps(receipt,indent=2)+'\\n')\n            print(json.dumps(receipt,sort_keys=True));break\n        else:raise SystemExit('Pinned Opus model acquisition failed: '+json.dumps(errors))\n        PYMODEL\n        cat > \"$RUNNER_TEMP/model-download-bin/wget\" <<'SHMODEL'\n        #!/usr/bin/env bash\n        set -euo pipefail\n        expected_name=\"opus_data-${OPUS_MODEL_SHA256}.tar.gz\"\n        expected_url=\"https://media.xiph.org/opus/models/${expected_name}\"\n        if [[ \"$#\" == 3 && \"$1\" == \"-O\" && \"$2\" == \"$expected_name\" && \"$3\" == \"$expected_url\" ]]; then\n          # Supply only the exact previously verified model. The unchanged Opus\n          # download script independently checks its SHA again before extraction.\n          cp -- \"$OPUS_PINNED_MODEL_PATH\" \"$2\"\n          printf 'Verified pinned Opus model supplied from cache: %s\\n' \"$OPUS_MODEL_SHA256\"\n        else\n          exec /usr/bin/wget \"$@\"\n        fi\n        SHMODEL\n        chmod 755 \"$RUNNER_TEMP/model-download-bin/wget\"\n        printf '%s\\n' \"$RUNNER_TEMP/model-download-bin\" >> \"$GITHUB_PATH\"\n        printf 'OPUS_PINNED_MODEL_PATH=%s\\n' \"$model_path\" >> \"$GITHUB_ENV\"\n        python3 - <<'PYSHIMRECEIPT'\n        import hashlib,json,os\n        from pathlib import Path\n        root=Path(os.environ['RUNNER_TEMP'])\n        receipt_path=root/'verified-opus-model/model-acquisition.json'\n        receipt=json.loads(receipt_path.read_text())\n        shim=root/'model-download-bin/wget'\n        receipt.update(shim_sha256=hashlib.sha256(shim.read_bytes()).hexdigest(),\n            shim_scope='Only exact pinned official model URL and output basename; all other invocations delegate /usr/bin/wget',\n            unchanged_opus_self_verification=True)\n        receipt_path.write_text(json.dumps(receipt,indent=2)+'\\n')\n        print(json.dumps(receipt,sort_keys=True))\n        PYSHIMRECEIPT\n    - name: Build exact production controller and codec runner without the GUI\n      timeout-minutes: 25\n      run: |\n        python3 tools/freedv/build_usb_controller_host.py --prepare-codec \\\n          --work \"$RUNNER_TEMP/usb-controller-build\" --jobs 2 \\\n          --build-id \"usb-controller-ci-${GITHUB_SHA}\" \\\n          > \"$RUNNER_TEMP/usb-controller-build.log\" 2>&1 || {\n            task_status=$?\n            python3 tools/freedv/usb_ci_diagnostics.py --work-root \"$RUNNER_TEMP\"\n            exit \"$task_status\"\n          }\n    - name: Run complete controller regression and lifecycle cases on private PulseAudio\n      timeout-minutes: 30\n      run: |\n        export LD_LIBRARY_PATH=\"$RUNNER_TEMP/usb-controller-build/codec/rade_c/src${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}\"\n        python3 tools/freedv/test_usb_audio_matrix.py \\\n          \"$RUNNER_TEMP/usb-controller-build/freedv_usb_audio_test\" \\\n          \"$RUNNER_TEMP/usb-controller-build/codec/sources/rade_c/input_sample.wav\" \\\n          \"$RUNNER_TEMP/usb-controller-build/usb-reference-48k.raw\" \\\n          --runner \"$RUNNER_TEMP/usb-controller-build/freedv_voice_runner\" \\\n          --rade-library \"$RUNNER_TEMP/usb-controller-build/codec/rade_c/src/librade.so.0.1\" \\\n          --output \"$RUNNER_TEMP/usb-controller-matrix\" --profile regression \\\n          --campaign-root \"$RUNNER_TEMP/usb-controller-campaigns\" \\\n          --source-commit \"$TESTED_SOURCE_COMMIT\" --build-id \"usb-controller-ci-${GITHUB_SHA}\" \\\n          > \"$RUNNER_TEMP/usb-controller-matrix.log\" 2>&1 || {\n            task_status=$?\n            python3 tools/freedv/usb_ci_diagnostics.py --work-root \"$RUNNER_TEMP\"\n            exit \"$task_status\"\n          }\n    - name: Retain bounded PCM only from failed public-fixture cases\n      if: failure()\n      timeout-minutes: 2\n      run: |\n        python3 tools/freedv/usb_ci_diagnostics.py --work-root \"$RUNNER_TEMP\" \\\n          --output \"$RUNNER_TEMP/usb-controller-failure-fixtures\"\n    - name: Retain successful and failed build/campaign evidence\n      if: always()\n      uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n      with:\n        name: usb-controller-evidence-${{ github.run_id }}-${{ github.run_attempt }}\n        retention-days: 14\n        if-no-files-found: warn\n        path: |\n          ${{ runner.temp }}/usb-controller-build.log\n          ${{ runner.temp }}/usb-controller-build/build-record.json\n          ${{ runner.temp }}/usb-controller-build/*.log\n          ${{ runner.temp }}/usb-controller-matrix.log\n          ${{ runner.temp }}/usb-controller-matrix/**/*.json\n          ${{ runner.temp }}/usb-controller-matrix/**/*.jsonl\n          ${{ runner.temp }}/usb-controller-matrix/**/*.log\n          ${{ runner.temp }}/usb-controller-matrix/**/*.txt\n          ${{ runner.temp }}/usb-controller-matrix/**/default.pa\n          ${{ runner.temp }}/usb-controller-campaigns/**/*.json\n          ${{ runner.temp }}/usb-controller-failure-fixtures/\n    - name: Retain actual tested-source receipt\n      if: always()\n      uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n      with:\n        name: tested-source-usb-controller-regression\n        retention-days: 14\n        if-no-files-found: error\n        path: ${{ runner.temp }}/tested-source-usb-controller-regression.json\n    - name: Retain pinned model acquisition receipt\n      if: always()\n      uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02\n      with:\n        name: pinned-opus-model-acquisition\n        retention-days: 14\n        if-no-files-found: warn\n        path: ${{ runner.temp }}/verified-opus-model/model-acquisition.json\n  windows-runner:\n    runs-on: windows-latest\n    timeout-minutes: 15\n    steps:\n    - name: Use canonical LF bytes before checkout\n      shell: bash\n      run: |\n        git config --global core.autocrlf false\n    - uses: actions/checkout@11bd71901bbe5b1630ceea73d27597364c9af683\n      with:\n        ref: 20cf0e65fecb6459fc8c7d6d40d65b514b82a11c\n    - name: Assert and record actual frozen product source\n      shell: python {0}\n      run: |\n        import hashlib\n        import json\n        import os\n        from pathlib import Path\n        import stat\n        import subprocess\n\n        expected = os.environ['TESTED_SOURCE_COMMIT']\n        actual = subprocess.check_output(['git', 'rev-parse', 'HEAD'], text=True).strip()\n        if actual != expected:\n            raise SystemExit('Checkout is not the frozen product commit: ' + actual)\n        dirty = subprocess.check_output(['git', 'status', '--porcelain', '--untracked-files=all'], text=True)\n        if dirty:\n            raise SystemExit('Frozen source checkout is dirty: ' + dirty)\n        staged = subprocess.check_output(['git', 'ls-files', '--stage', '-z']).decode().split('\\0')\n        files, skipped_gitlinks = {}, []\n        for entry in staged:\n            if not entry:\n                continue\n            header, name = entry.split('\\t', 1)\n            mode, object_id, stage = header.split()\n            if stage != '0':\n                raise SystemExit('Unmerged source index: ' + name)\n            if mode == '160000':\n                skipped_gitlinks.append(name)\n                continue\n            path = Path(name)\n            if mode not in ('100644', '100755') or not stat.S_ISREG(path.lstat().st_mode):\n                raise SystemExit('Unexpected tracked nonregular file: ' + name)\n            with path.open('rb') as stream:\n                files[name] = hashlib.file_digest(stream, 'sha256').hexdigest()\n        files = dict(sorted(files.items()))\n        tree = hashlib.sha256(''.join(digest + '  ' + name + '\\n' for name, digest in files.items()).encode()).hexdigest()\n        receipt = {\n            'schema': 'x6200.usb.ci-tested-source.v1',\n            'source_commit': actual,\n            'expected_source_commit': expected,\n            'source_worktree_dirty': False,\n            'source_files': files,\n            'source_file_count': len(files),\n            'source_tree_sha256': tree,\n            'skipped_gitlinks': sorted(skipped_gitlinks),\n            'workflow_commit': os.environ['GITHUB_SHA'],\n            'workflow_ref': os.environ['GITHUB_WORKFLOW_REF'],\n            'job': os.environ['GITHUB_JOB'],\n            'run_id': os.environ['GITHUB_RUN_ID'],\n            'run_attempt': os.environ['GITHUB_RUN_ATTEMPT'],\n        }\n        output = Path(os.environ['RUNNER_TEMP']) / ('tested-source-' + os.environ['GITHUB_JOB'] + '.json')\n        output.write_text(json.dumps(receipt, indent=2) + '\\n', encoding='utf-8')\n        print(json.dumps({key: value for key, value in receipt.items() if key != 'source_files'}, sort_keys=True))\n        print('Source receipt: ' + str(output))\n    - name: Check inventory collection and failure preservation\n      shell: powershell\n      run: tools/freedv/test_usb_headset_inventory_runner.ps1\n    - name: Check validation collection and failure preservation\n      shell: powershell\n      run: |\n        tools/freedv/test_usb_headset_validation_runner.ps1\n        tools/freedv/test_usb_half_duplex_runner.ps1\n        tools/freedv/test_