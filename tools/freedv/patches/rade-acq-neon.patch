+static void rade_acq_grid_neon(rade_acq *acq, const RADE_COMP *rx) {
+    /* Bounded scratch: 16,632 bytes with current V1 dimensions. Copying
+       representations once gives vector loads a genuine float array;
+       no pointer arithmetic crosses RADE_COMP structure boundaries.
+       Production streaming worker stack size is not yet qualified. */
+    float packed_rx[2 * (2 * RADE_NMF + RADE_M - 1)];
+    assert(acq->nmf > 0 && acq->nmf <= RADE_NMF);
+    assert(acq->m > 0 && acq->m <= RADE_M);
+    size_t count = 2 * acq->nmf + acq->m - 1;
+    memcpy(packed_rx, rx, count * sizeof(RADE_COMP));
+    int t = 0;
+    for (; t + 3 < acq->nmf; t += 4)
+        for (int f = 0; f < acq->n_fcoarse; f++)
+            rade_acq_correlate4(acq, packed_rx, t, f);
+    /* Retain scalar handling for one to three final timing positions. */
+    for (; t < acq->nmf; t++) {
+        for (int f = 0; f < acq->n_fcoarse; f++) {
+            RADE_COMP a = rade_czero(), b = rade_czero();
+            for (int n = 0; n < acq->m; n++) {
+                a = rade_cadd(a, rade_cmul(rade_cconj(rx[t + n]), acq->p_w[f][n]));
+                b = rade_cadd(b, rade_cmul(rade_cconj(rx[t + acq->nmf + n]), acq->p_w[f][n]));
+            }
+            acq->Dt1[t][f] = a;
+            acq->Dt2[t][f] = b;
+        }
+    }
+}
