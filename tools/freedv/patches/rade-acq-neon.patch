+/* An explicit sign-bit flip avoids compiler scalarization of vnegq_f32
+   under strict floating-point options, without enabling unsafe math. */
+static inline float32x4_t rade_acq_negate4(float32x4_t value) {
+    return vreinterpretq_f32_u32(veorq_u32(vreinterpretq_u32_f32(value),
+                                        vdupq_n_u32(0x80000000u)));
+}
+
+static void rade_acq_correlate4(rade_acq *acq, const float *rx,
+                              int t, int f_idx) {
+    float32x4_t ar1 = vdupq_n_f32(0.0f);
+    float32x4_t ai1 = vdupq_n_f32(0.0f);
+    float32x4_t ar2 = vdupq_n_f32(0.0f);
+    float32x4_t ai2 = vdupq_n_f32(0.0f);
+    for (int n = 0; n < acq->m; n++) {
+        float32x4x2_t x1 = vld2q_f32(&rx[2 * (t + n)]);
+        float32x4x2_t x2 = vld2q_f32(&rx[2 * (t + acq->nmf + n)]);
+        float32x4_t pr = vdupq_n_f32(acq->p_w[f_idx][n].real);
+        float32x4_t pi = vdupq_n_f32(acq->p_w[f_idx][n].imag);
+        float32x4_t r1 = vfmaq_f32(vmulq_f32(x1.val[1], pi), x1.val[0], pr);
+        float32x4_t i1 = vfmaq_f32(rade_acq_negate4(vmulq_f32(x1.val[1], pr)), x1.val[0], pi);
+        float32x4_t r2 = vfmaq_f32(vmulq_f32(x2.val[1], pi), x2.val[0], pr);
+        float32x4_t i2 = vfmaq_f32(rade_acq_negate4(vmulq_f32(x2.val[1], pr)), x2.val[0], pi);
+        ar1 = vaddq_f32(ar1, r1);
+        ai1 = vaddq_f32(ai1, i1);
+        ar2 = vaddq_f32(ar2, r2);
+        ai2 = vaddq_f32(ai2, i2);
+    }
+    float rr1[4], ii1[4], rr2[4], ii2[4];
+    vst1q_f32(rr1, ar1); vst1q_f32(ii1, ai1);
+    vst1q_f32(rr2, ar2); vst1q_f32(ii2, ai2);
+    for (int lane = 0; lane < 4; lane++) {
+        acq->Dt1[t + lane][f_idx].real = rr1[lane];
+        acq->Dt1[t + lane][f_idx].imag = ii1[lane];
+        acq->Dt2[t + lane][f_idx].real = rr2[lane];
+        acq->Dt2[t + lane][f_idx].imag = ii2[lane];
+    }
+}
