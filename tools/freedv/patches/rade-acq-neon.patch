+#if RADE_ACQ_NEON
+/* Each lane is one independent time offset, not a partial reduction. The
+   sample reduction still runs n=0..M-1. Products match the original GCC 12
+   Cortex-A7 scalar VFP fusion pattern; accumulation remains a separate add.
+   ARMv7 NEON has fixed round-to-nearest and flush-to-zero semantics. Select
+   it only in a conservative finite domain whose exact product lattice is
+   2^-118 or coarser, so nonzero products/FMA cancellation/ordered sums stay
+   normal. Out-of-domain data retains the original scalar implementation. */
+static int rade_acq_component_in_range(float value, uint32_t minimum) {
+    uint32_t bits;
+    memcpy(&bits, &value, sizeof(bits));
+    bits &= 0x7fffffffu;
+    /* 0x47800000 is 2^16. NaN/Inf and subnormal values fail this check. */
+    return bits == 0 || (bits >= minimum && bits <= 0x47800000u);
+}
+
+static int rade_acq_can_use_neon(const rade_acq *acq, const RADE_COMP *rx) {
+    if (acq->nmf < 4 || acq->nmf > RADE_NMF ||
+        acq->m <= 0 || acq->m > RADE_M ||
+        acq->n_fcoarse <= 0 || acq->n_fcoarse > RADE_ACQ_NFREQ ||
+        fegetround() != FE_TONEAREST)
+        return 0;
+    size_t count = 2 * acq->nmf + acq->m - 1;
+    for (size_t i = 0; i < count; i++) {
+        /* RX lower bound 2^-40: float lattice spacing at least 2^-63. */
+        if (!rade_acq_component_in_range(rx[i].real, 0x2b800000u) ||
+            !rade_acq_component_in_range(rx[i].imag, 0x2b800000u))
+            return 0;
+    }
+    for (int f = 0; f < acq->n_fcoarse; f++) {
+        for (int n = 0; n < acq->m; n++) {
+            /* Pilot lower bound 2^-32: spacing at least 2^-55. */
+            if (!rade_acq_component_in_range(acq->p_w[f][n].real, 0x2f800000u) ||
+                !rade_acq_component_in_range(acq->p_w[f][n].imag, 0x2f800000u))
+                return 0;
+        }
+    }
+    return 1;
+}
